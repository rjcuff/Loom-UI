# Prettier is pinned to endOfLine: lf. Without this, a checkout on Windows
# rewrites everything to CRLF and `pnpm format:check` fails on files nobody
# touched.
* text=auto eol=lf

# Generated by the registry build. Collapse it in diffs and reviews.
apps/www/registry/__index__.tsx linguist-generated=true
apps/www/registry.json          linguist-generated=true
apps/www/public/r/*.json        linguist-generated=true
apps/www/public/llms*.txt       linguist-generated=true
pnpm-lock.yaml                  linguist-generated=true

# Binary. Never diff, never normalize.
*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary
