      "cssVars": {
        "theme": {
          "animate-caret-blink": "caret-blink 1.1s steps(2, jump-none) infinite"
        }
      },
      "css": {
        "@keyframes caret-blink": {
          "0%, 100%": {
            "opacity": "1"
          },
          "50%": {
            "opacity": "0"
          }
        }
      }
    },
