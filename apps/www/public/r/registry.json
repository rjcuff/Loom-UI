    {
      "name": "aurora-backdrop",
      "type": "registry:ui",
      "title": "Aurora Backdrop",
      "description": "A wash of blurred colour that drifts behind content on cycles that never line up.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/loomui/aurora-backdrop.tsx",
          "type": "registry:ui"
